#!/usr/bin/python3
"""KINFX Input IBus engine. Started by ibus-daemon from kinfx-input.xml (--ibus)."""
import os
import sys

import gi
gi.require_version("IBus", "1.0")
from gi.repository import GLib, GObject, IBus  # noqa: E402

sys.path.insert(0, os.environ.get("KX_LIB", "/usr/lib/kinfx-input"))
import kxcore  # noqa: E402

# IBus modifier bits are the X11 ones Rime expects; release is 1 << 30 in both.
MASK = (IBus.ModifierType.SHIFT_MASK | IBus.ModifierType.LOCK_MASK | IBus.ModifierType.CONTROL_MASK
        | IBus.ModifierType.MOD1_MASK | IBus.ModifierType.SUPER_MASK | IBus.ModifierType.RELEASE_MASK)

ENGINE = kxcore.Engine()

# Bare Ctrl+Shift / Alt+Shift are chords, like the Windows shell: Windows/IBus would otherwise
# switch the input method before Rime sees the keys. Track the modifiers here and hand the
# chord to Rime as Control+space, which owns ascii_mode (key_bindings.yaml).
MODS = {
    IBus.KEY_Control_L: 1, IBus.KEY_Control_R: 1,
    IBus.KEY_Shift_L: 2, IBus.KEY_Shift_R: 2,
    IBus.KEY_Alt_L: 4, IBus.KEY_Alt_R: 4,
}
CHORDS = (1 | 2, 4 | 2)  # Ctrl+Shift, Alt+Shift


class KxEngine(IBus.Engine):
    __gtype_name__ = "KxEngine"

    def __init__(self, **kw):
        super().__init__(**kw)
        self.sess = 0
        self.table = IBus.LookupTable.new(9, 0, False, False)
        self.mods = 0      # modifiers currently down
        self.peak = 0      # every modifier seen since the chord started
        self.dirty = False  # a real key broke the chord

    def _chord(self, keyval, state):
        """Returns True when the key completed a bare chord (and the toggle was sent)."""
        bit = MODS.get(keyval)
        if bit is None:
            self.dirty = True  # any other key means it was a shortcut
            return False
        if not state & IBus.ModifierType.RELEASE_MASK:
            if not self.mods:
                self.peak = 0
                self.dirty = False
            self.mods |= bit
            self.peak |= self.mods
            return False
        self.mods &= ~bit
        if self.mods:
            return False
        hit = not self.dirty and self.peak in CHORDS
        self.peak = 0
        self.dirty = False
        if not hit:
            return False
        ENGINE.key(self.sess, IBus.KEY_space, int(IBus.ModifierType.CONTROL_MASK))
        self._update()
        return True

    def _session(self):
        if not ENGINE.alive(self.sess):
            self.sess = ENGINE.session()
        return self.sess

    def do_process_key_event(self, keyval, keycode, state):
        if not self._session():
            return False
        if self._chord(keyval, state):
            return True
        handled = ENGINE.key(self.sess, keyval, int(state) & int(MASK))
        self._update()
        return handled

    def _update(self):
        text = ENGINE.commit(self.sess)
        if text:
            self.commit_text(IBus.Text.new_from_string(text))
        pre, cur, page, cands = ENGINE.view(self.sess)
        # Focus out / reset: ibus (daemon, or the GTK client) commits a COMMIT-mode preedit into the
        # field being left; an engine commit_text there lands in the next field (one global engine).
        # So the preedit is what blur keeps (vd -> \u597d); the code still shows as auxiliary text.
        shown = ENGINE.blur_text(self.sess)
        if shown and shown != pre:
            cur = len(shown)
        self.update_auxiliary_text(IBus.Text.new_from_string(pre), bool(shown) and shown != pre)
        self.update_preedit_text_with_mode(IBus.Text.new_from_string(shown or pre), cur, bool(shown or pre),
                                           IBus.PreeditFocusMode.COMMIT if shown else IBus.PreeditFocusMode.CLEAR)
        if not cands:
            self.hide_lookup_table()
            return
        horizontal = ENGINE.settings.get("candidate_layout") == "horizontal"
        t = self.table
        t.clear()
        t.set_page_size(max(page, len(cands)))
        t.set_orientation(IBus.Orientation.HORIZONTAL if horizontal else IBus.Orientation.VERTICAL)
        for i, (c, comment) in enumerate(cands):
            t.append_candidate(IBus.Text.new_from_string(c + (" " + comment if comment else "")))
            t.set_label(i, IBus.Text.new_from_string("%d." % ((i + 1) % 10)))
        t.set_cursor_visible(False)
        self.update_lookup_table(t, True)

    def do_focus_in(self):
        ENGINE.reload_if_changed()

    def do_focus_out(self):
        if self.sess:  # ibus already committed the COMMIT-mode preedit (_update)
            ENGINE.lib.kx_clear(self.sess)
            ENGINE.commit(self.sess)  # drop: clearing flushes held top-outs, already in that preedit
        self.update_preedit_text(IBus.Text.new_from_string(""), 0, False)
        self.hide_lookup_table()

    def do_reset(self):
        self.do_focus_out()

    def do_candidate_clicked(self, index, button, state):
        # Same as pressing the label digit.
        if self._session():
            ENGINE.key(self.sess, ord(str((index + 1) % 10)), 0)
            self._update()


def main():
    IBus.init()
    bus = IBus.Bus()
    factory = IBus.Factory.new(bus.get_connection())
    factory.add_engine("kinfx", GObject.type_from_name("KxEngine"))
    if "--ibus" in sys.argv:
        bus.request_name("hk.kinfx.Input", 0)
    # After request_name: ibus-daemon times out if the first Rime deploy runs before it.
    # CreateEngine waits in the queue until loop.run().
    ENGINE.start()
    bus.connect("disconnected", lambda *_: loop.quit())
    loop = GLib.MainLoop()
    loop.run()


if __name__ == "__main__":
    main()
