<?xml version="1.0" encoding="utf-8"?>
<installer-gui-script minSpecVersion="2">
  <title>KINFX Input</title>
  <!-- Current user only: ~/Library/Input Methods, no administrator password. -->
  <domains enable_anywhere="false" enable_currentUserHome="true" enable_localSystem="false"/>
  <options customize="never" require-scripts="false" hostArchitectures="arm64,x86_64"/>
  <choices-outline><line choice="default"><line choice="kinfx"/></line></choices-outline>
  <choice id="default"/>
  <choice id="kinfx" visible="false"><pkg-ref id="hk.kinfx.inputmethod.KINFXInput.pkg"/></choice>
  <pkg-ref id="hk.kinfx.inputmethod.KINFXInput.pkg">KINFXInput-component.pkg</pkg-ref>
</installer-gui-script>
