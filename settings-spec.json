{
  "_comment": "Shared by every KINFX Input shell. options[0] is the default. rime_key null = shell-only setting. settings.json stores page_size as a number, association as a bool, the rest as strings.",
  "settings": [
    {"key": "page_size", "label": "每頁候選數", "rime_key": "menu/page_size",
     "options": [["9", "9 個"], ["5", "5 個"]]},
    {"key": "english_space", "label": "英文詞後按空白", "rime_key": "english/space",
     "options": [["safe", "安全詞上屏"], ["long", "只限長詞"], ["off", "關閉"]]},
    {"key": "association", "label": "聯想詞", "rime_key": "association/enable",
     "options": [["true", "開啟"], ["false", "關閉"]]},
    {"key": "space_after_pick", "label": "選字後按空白", "rime_key": "association/space",
     "options": [["page", "翻頁"], ["type", "輸入空格"]]},
    {"key": "phrase_capture", "label": "常用詞前綴", "rime_key": "phrase_mix/capture",
     "options": [["hot", "熱門"], ["all", "全部"], ["off", "關閉"]], "rime_value": {"off": "none"}},
    {"key": "empty_shift", "label": "未輸入時按左 Shift", "rime_key": "english/empty_shift",
     "options": [["noop", "不動作"], ["ascii", "臨時英文"]]},
    {"key": "preedit", "label": "預編輯顯示", "rime_key": "english/preedit",
     "options": [["letters", "字母"], ["radicals", "字根"]]},
    {"key": "candidate_layout", "label": "選字表", "rime_key": null,
     "options": [["vertical", "直排"], ["horizontal", "橫排"]]}
  ]
}
